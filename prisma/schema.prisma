// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
    provider        = "prisma-client-js"
    previewFeatures = ["relationJoins"]
}

datasource db {
    provider = "postgresql"
    // NOTE: When using mysql or sqlserver, uncomment the @db.Text annotations in model Account below
    // Further reading:
    // https://next-auth.js.org/adapters/prisma#create-the-prisma-schema
    // https://www.prisma.io/docs/reference/api-reference/prisma-schema-reference#string
    url      = env("DATABASE_URL")
}

// Necessary for Next auth
model Account {
    id                String  @id @default(cuid())
    userId            Int
    type              String
    provider          String
    providerAccountId String
    refresh_token     String? // @db.Text
    access_token      String? // @db.Text
    expires_at        Int?
    token_type        String?
    scope             String?
    id_token          String? // @db.Text
    session_state     String?
    user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@unique([provider, providerAccountId])
}

model Session {
    id           String   @id @default(cuid())
    sessionToken String   @unique
    userId       Int
    expires      DateTime
    user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
    id                  Int                  @id @default(autoincrement())
    name                String?
    email               String?              @unique
    emailVerified       DateTime?
    image               String?
    currency            String               @default("USD")
    accounts            Account[]
    sessions            Session[]
    groups              Group[]              @relation("GroupCreatedBy")
    defaultSplitGroups  Group[]              @relation("GroupDefaultSplitBy")
    associatedGroups    GroupUser[]
    expenseParticipants ExpenseParticipant[]
    expenseNotes        ExpenseNote[]
    userBalances        Balance[]            @relation("UserBalance")
    friendBalances      Balance[]            @relation("FriendBalance")
    groupUserBalances   GroupBalance[]       @relation("GroupUserBalance")
    groupFriendBalances GroupBalance[]       @relation("GroupFriendBalance")
    paidExpenses        Expense[]            @relation("PaidByUser")
    addedExpenses       Expense[]            @relation("AddedByUser")
    deletedExpenses     Expense[]            @relation("DeletedByUser")
    updatedExpenses     Expense[]            @relation("UpdatedByUser")
    friendships         Friendship[]         @relation("UserFriendships")
    friendOf            Friendship[]         @relation("FriendFriendships")
    recurringExpenses   RecurringExpense[]
}

model VerificationToken {
    identifier String
    token      String   @unique
    expires    DateTime

    @@unique([identifier, token])
}

model Balance {
    userId                Int
    currency              String
    friendId              Int
    amount                Int
    createdAt             DateTime @default(now())
    updatedAt             DateTime @updatedAt
    importedFromSplitwise Boolean  @default(false)
    user                  User     @relation(name: "UserBalance", fields: [userId], references: [id], onDelete: Cascade)
    friend                User     @relation(name: "FriendBalance", fields: [friendId], references: [id], onDelete: Cascade)

    @@id([userId, currency, friendId])
}

model Friendship {
    userId    Int
    friendId  Int
    createdAt DateTime @default(now())
    user      User     @relation(name: "UserFriendships", fields: [userId], references: [id], onDelete: Cascade)
    friend    User     @relation(name: "FriendFriendships", fields: [friendId], references: [id], onDelete: Cascade)

    @@id([userId, friendId])
    @@index([friendId])
}

model Group {
    id               Int            @id @default(autoincrement())
    publicId         String         @unique
    name             String
    userId           Int
    defaultCurrency  String         @default("USD")
    createdAt        DateTime       @default(now())
    updatedAt        DateTime       @updatedAt
    splitwiseGroupId String?        @unique
    /// Applied to new expenses in the group. Shares are a JSON object of user id to share.
    defaultSplitType   SplitType?
    defaultSplitShares Json?
    defaultSplitById   Int?
    defaultSplitAt     DateTime?
    createdBy        User           @relation("GroupCreatedBy", fields: [userId], references: [id], onDelete: Cascade)
    defaultSplitBy   User?          @relation("GroupDefaultSplitBy", fields: [defaultSplitById], references: [id], onDelete: SetNull)
    groupUsers       GroupUser[]
    expenses         Expense[]
    groupBalances    GroupBalance[]
    recurringExpenses RecurringExpense[]
}

model GroupUser {
    groupId Int
    userId  Int
    user    User  @relation(fields: [userId], references: [id], onDelete: Cascade)
    group   Group @relation(fields: [groupId], references: [id], onDelete: Cascade)

    @@id([groupId, userId])
}

model GroupBalance {
    groupId   Int
    currency  String
    userId    Int
    firendId  Int
    amount    Int
    updatedAt DateTime @updatedAt
    group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
    user      User     @relation(name: "GroupUserBalance", fields: [userId], references: [id], onDelete: Cascade)
    friend    User     @relation(name: "GroupFriendBalance", fields: [firendId], references: [id], onDelete: Cascade)

    @@id([groupId, currency, firendId, userId])
    @@index([currency, userId, firendId])
}

enum SplitType {
    EQUAL
    PERCENTAGE
    EXACT
    SHARE
    ADJUSTMENT
    SETTLEMENT
}

model Expense {
    id                  String               @id @default(cuid())
    paidBy              Int
    addedBy             Int
    name                String
    category            String
    amount              Int
    splitType           SplitType            @default(EQUAL)
    expenseDate         DateTime             @default(now())
    createdAt           DateTime             @default(now())
    updatedAt           DateTime             @updatedAt
    currency            String
    fileKey             String?
    groupId             Int?
    deletedAt           DateTime?
    deletedBy           Int?
    updatedBy           Int?
    settlementAllocationVersion Int?
    /// The rule this expense was repeated by, and the local date it stands for.
    recurringId         Int?
    occurrenceDate      DateTime?            @db.Date
    group               Group?               @relation(fields: [groupId], references: [id], onDelete: Cascade)
    paidByUser          User                 @relation(name: "PaidByUser", fields: [paidBy], references: [id], onDelete: Cascade)
    addedByUser         User                 @relation(name: "AddedByUser", fields: [addedBy], references: [id], onDelete: Cascade)
    deletedByUser       User?                @relation(name: "DeletedByUser", fields: [deletedBy], references: [id], onDelete: Cascade)
    updatedByUser       User?                @relation(name: "UpdatedByUser", fields: [updatedBy], references: [id], onDelete: SetNull)
    expenseParticipants ExpenseParticipant[]
    expenseNotes        ExpenseNote[]
    settlementAllocations SettlementAllocation[]
    recurring           RecurringExpense?    @relation(fields: [recurringId], references: [id], onDelete: SetNull)

    @@unique([recurringId, occurrenceDate])
    @@index([groupId])
    @@index([paidBy])
}

enum RecurringFrequency {
    DAILY
    WEEKLY
    MONTHLY
    LAST_DAY_OF_MONTH
    YEARLY
}

enum RecurringStatus {
    ACTIVE
    PAUSED
    STOPPED
}

/// Repeats an expense on a preset schedule. Each occurrence copies the latest one not deleted.
model RecurringExpense {
    id                 Int                @id @default(autoincrement())
    frequency          RecurringFrequency
    /// The creator's IANA time zone, in which dates start.
    timezone           String
    /// The local date of the expense it was set up on, which the schedule counts from.
    startDate          DateTime           @db.Date
    /// The local date of the next occurrence, and when it is due (the start of that day).
    nextOccurrenceDate DateTime           @db.Date
    nextOccurrenceAt   DateTime
    status             RecurringStatus    @default(ACTIVE)
    statusReason       String?
    /// The occurrence the next one copies, and everyone in it (payer and zero shares included).
    /// Kept without relations, so an account being removed can't silently change or clear them.
    templateExpenseId  String?
    templateUserIds    Int[]              @default([])
    groupId            Int?
    /// Null once their account is removed, which stops the rule.
    createdById        Int?
    createdAt          DateTime           @default(now())
    updatedAt          DateTime           @updatedAt
    group              Group?             @relation(fields: [groupId], references: [id], onDelete: Cascade)
    createdBy          User?              @relation(fields: [createdById], references: [id], onDelete: SetNull)
    occurrences        Expense[]

    @@index([status, nextOccurrenceAt])
    @@index([groupId])
}

/// App-wide settings and runtime markers, by key.
model AppMetadata {
    key       String   @id
    value     String
    updatedAt DateTime @updatedAt
}

model SettlementAllocation {
    settlementExpenseId String
    /// Kept without a relation so deleting a settled group does not erase settlement provenance.
    groupId             Int
    currency            String
    userId              Int
    friendId            Int
    amount              Int
    createdAt           DateTime @default(now())
    settlementExpense   Expense  @relation(fields: [settlementExpenseId], references: [id], onDelete: Cascade)

    @@id([settlementExpenseId, groupId, currency, friendId, userId])
    @@index([groupId, currency, friendId, userId])
}

/// Audit trail of the one-off balance repair (src/scripts/repair-balances.ts), so a run can be
/// undone. No relations, so the log outlives the rows it describes.
model BalanceRepairLog {
    id        Int      @id @default(autoincrement())
    runId     String
    /// "set:<setId>": the unit applied in one transaction.
    scope     String
    /// Always "GroupBalance": the repair never writes anything else.
    table     String
    groupId   Int?
    currency  String?
    expenseId String?
    userId    Int
    friendId  Int?
    /// null when the row did not exist; undo deletes it again
    before    Int?
    delta     Int
    after     Int?
    reason    String
    /// When the run (or undo) wrote this row, from the database clock
    createdAt DateTime @default(now())

    @@index([runId, scope])
}

model ExpenseParticipant {
    expenseId String
    userId    Int
    amount    Int
    user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
    expense   Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)

    @@id([expenseId, userId])
}

model ExpenseNote {
    id          String   @id @default(cuid())
    expenseId   String
    note        String
    createdById Int
    createdAt   DateTime @default(now())
    createdBy   User     @relation(fields: [createdById], references: [id], onDelete: Cascade)
    expense     Expense  @relation(fields: [expenseId], references: [id], onDelete: Cascade)
}

model PushNotification {
    userId       Int    @id
    subscription String
}

model RateLimit {
    key         String   @id
    count       Int
    windowStart DateTime
    expiresAt   DateTime

    @@index([expiresAt])
}

// Public splits that work without an account. Anyone with the link can view and edit one, so the
// id is long and random. Amounts are in the currency's minor unit, like Expense.amount.
model QuickSplit {
    id        String              @id
    name      String
    currency  String
    createdAt DateTime            @default(now())
    updatedAt DateTime            @updatedAt
    people    QuickSplitPerson[]
    expenses  QuickSplitExpense[]
}

model QuickSplitPerson {
    id        String     @id @default(cuid())
    splitId   String
    name      String
    createdAt DateTime   @default(now())
    split     QuickSplit @relation(fields: [splitId], references: [id], onDelete: Cascade)

    @@index([splitId])
}

model QuickSplitExpense {
    id         String     @id @default(cuid())
    splitId    String
    title      String
    amount     Int
    paidBy     String
    // Person ids sharing the expense. `exact` is empty for an equal split, otherwise the amount
    // each person in `splitAmong` owes, in the same order.
    splitAmong String[]
    exact      Int[]
    isPayment  Boolean    @default(false)
    createdAt  DateTime   @default(now())
    updatedAt  DateTime   @updatedAt
    split      QuickSplit @relation(fields: [splitId], references: [id], onDelete: Cascade)

    @@index([splitId, createdAt])
}
