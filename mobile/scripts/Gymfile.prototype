require 'shellwords'

clean(true)
scheme('SplitPro')
configuration('Release')

# Gym detects the provisioning profile from the project that EAS configures after the hook.
export_options({
  method: 'app-store-connect',
  teamID: 'G5MR932BV5',
  testFlightInternalTestingOnly: true,
  manageAppVersionAndBuildNumber: false
})

# Use EAS's restored signing keychain without reading or copying any key material.
keychain = `security list-keychains -d user`.scan(/"([^"]+)"/).flatten.find do |path|
  File.basename(path).start_with?('eas-build-')
end
raise 'EAS signing keychain not found' unless keychain
export_xcargs("OTHER_CODE_SIGN_FLAGS=#{Shellwords.escape("--keychain #{keychain}")}")

disable_xcpretty(true)
output_directory('./build')
output_name('App')
